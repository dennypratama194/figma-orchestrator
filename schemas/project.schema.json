{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalrevo.id/schemas/figma-orchestrator/project.schema.json",
  "title": "Figma Orchestrator Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "projectType", "brief", "scope"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "projectType": { "enum": ["marketing-website", "web-app", "mobile-app", "design-system"] },
    "brief": { "type": "string", "minLength": 1 },
    "figmaUrl": { "type": ["string", "null"], "format": "uri" },
    "brandAssets": { "type": "array", "items": { "type": "string" }, "default": [] },
    "references": { "type": "array", "items": { "type": "string" }, "default": [] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screens"],
      "properties": {
        "screens": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "breakpoints": { "type": "array", "items": { "type": "integer", "minimum": 320 }, "default": [1440, 768, 390] },
        "prototype": { "type": "boolean", "default": false }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" }, "default": [] },
    "approvalOwner": { "type": "string", "default": "Denny" }
  }
}
